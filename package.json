{
  "name": "propbetedge-soccer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PropBetEdge Soccer Intelligence: owned soccer data graph, event-level field model, evidence-backed news.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/release/gate.mjs --tests-only",
    "guard": "node scripts/guard-truth.mjs",
    "check": "node scripts/release/gate.mjs",
    "audit:sources": "node scripts/evidence/source-audit.mjs",
    "proof": "node scripts/backfill/proof-bundesliga-2017.mjs",
    "matrix": "node scripts/matrix.mjs",
    "coverage:openligadb": "node scripts/coverage/openligadb-depth.mjs",
    "proof:article": "node scripts/news/proof-article.mjs",
    "dev": "vite",
    "build": "node scripts/guard-truth.mjs && node scripts/guard-source-brand.mjs && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "test:web": "node --test \"tests/web/**/*.test.js\"",
    "qa:browser": "node scripts/qa/browser.mjs",
    "guard:source-brand": "node scripts/guard-source-brand.mjs",
    "prebuild": "npm run check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "axe-core": "^4.13.0",
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.12.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@vercel/og": "0.6.8"
  }
}
