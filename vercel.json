{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/soccer/pro/access",
      "missing": [
        {
          "type": "cookie",
          "key": "pbe_session"
        }
      ],
      "destination": "/soccer-free-access.json"
    },
    {
      "source": "/api/soccer/pro/catalog",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/pro/catalog"
    },
    {
      "source": "/api/soccer/pro/:path*",
      "destination": "/api/soccer?path=pro/:path*"
    },
    {
      "source": "/api/soccer/health",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/health"
    },
    {
      "source": "/api/soccer/coverage",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/coverage"
    },
    {
      "source": "/api/soccer/competitions",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/competitions"
    },
    {
      "source": "/api/soccer/competitions/:slug",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/competitions/:slug"
    },
    {
      "source": "/api/soccer/matches",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/matches"
    },
    {
      "source": "/api/soccer/matches/:id/cast",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/matches/:id/cast"
    },
    {
      "source": "/api/soccer/matches/:id/analyzer-preview",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/matches/:id/analyzer-preview"
    },
    {
      "source": "/api/soccer/matches/:id",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/matches/:id"
    },
    {
      "source": "/api/soccer/teams/:slug/dna",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/teams/:slug/dna"
    },
    {
      "source": "/api/soccer/teams/:slug/history",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/teams/:slug/history"
    },
    {
      "source": "/api/soccer/teams/:slug",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/teams/:slug"
    },
    {
      "source": "/api/soccer/players",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/players"
    },
    {
      "source": "/api/soccer/players/:slug/dna",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/players/:slug/dna"
    },
    {
      "source": "/api/soccer/players/:slug",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/players/:slug"
    },
    {
      "source": "/api/soccer/table",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/table"
    },
    {
      "source": "/api/soccer/news",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/news"
    },
    {
      "source": "/api/soccer/news/:slug",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/news/:slug"
    },
    {
      "source": "/api/soccer/live",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/live"
    },
    {
      "source": "/api/soccer/media/:sha",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/media/:sha"
    },
    {
      "source": "/api/soccer/videos",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/videos"
    },
    {
      "source": "/api/soccer/algo/v2/:kind(picks|record|research)",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/algo/v2/:kind"
    },
    {
      "source": "/api/soccer/algo/:kind(picks|record|research)",
      "destination": "https://soccer-api.sales-fd3.workers.dev/v1/algo/:kind"
    },
    {
      "source": "/api/markets/v1/market-intelligence/sport/soccer",
      "destination": "https://propsports-markets.sales-fd3.workers.dev/v1/market-intelligence/sport/soccer"
    },
    {
      "source": "/api/markets/v1/market-intelligence/event/soccer/:id([0-9a-f-]+)",
      "destination": "https://propsports-markets.sales-fd3.workers.dev/v1/market-intelligence/event/soccer/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?kind=index"
    },
    {
      "source": "/sitemap-:kind.xml",
      "destination": "/api/sitemap?kind=:kind"
    },
    {
      "source": "/og/:type/:key.png",
      "destination": "/api/og?type=:type&key=:key"
    },
    {
      "source": "/(competitions|matches|teams|players|tables|news|sources)",
      "destination": "/index.html"
    },
    {
      "source": "/(competitions|matches|teams|players|tables|news|sources)/:rest*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://auth.propbetedge.ai https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/soccer/media/:sha",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/api/soccer/matches/:id/cast",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=60"
        }
      ]
    },
    {
      "source": "/api/soccer/live",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=60"
        }
      ]
    },
    {
      "source": "/api/soccer/news",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=300"
        }
      ]
    },
    {
      "source": "/api/soccer/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(brand|share)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|icon-192.png|icon-512.png|icon-maskable-512.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
